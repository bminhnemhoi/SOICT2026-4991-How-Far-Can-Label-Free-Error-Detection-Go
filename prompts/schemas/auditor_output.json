{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditorOutput",
  "type": "object",
  "required": ["label", "confidence", "explanation", "evidence_features"],
  "additionalProperties": false,
  "properties": {
    "label": {"enum": ["error", "clean"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "explanation": {"type": "string", "maxLength": 600},
    "suspicious_fields": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 32
    },
    "evidence_features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stat_anomalies": {"type": "array", "items": {"type": "string"}},
        "pattern_issues": {"type": "array", "items": {"type": "string"}},
        "missingness_issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
